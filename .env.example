# =====================================================================
# CAPS – Central Admission Processing System (Fixiam IAM demonstration)
# Copy to .env.local for local development. NEVER commit real values.
# In production, configure these in Vercel → Project → Settings → Environment Variables.
# =====================================================================

# --- Supabase PostgreSQL (see docs/supabase-setup.md) ----------------------
# App runtime (Vercel): Supabase "Transaction pooler" URI, port 6543.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Prepared statements are disabled in the client, as the transaction pooler requires.
DATABASE_URL=
# Migrations / seed / db:check (your machine only, NOT Vercel): "Session pooler" URI, port 5432.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The migration and seed scripts refuse a transaction-pooler URL.
MIGRATION_DATABASE_URL=

# --- Application session -------------------------------------------------
# Random secret, >= 32 chars. Generate: openssl rand -base64 48
SESSION_SECRET=
# Absolute session lifetime and idle timeout (minutes).
SESSION_MAX_AGE_MINUTES=480
SESSION_IDLE_TIMEOUT_MINUTES=60

# --- Fixiam OpenID Connect ------------------------------------------------
# Issuer URL; CAPS reads <issuer>/.well-known/openid-configuration.
FIXIAM_ISSUER_URL=
FIXIAM_CLIENT_ID=
FIXIAM_CLIENT_SECRET=
# e.g. https://<your-app>.vercel.app/api/auth/callback
FIXIAM_REDIRECT_URI=
# e.g. https://<your-app>.vercel.app/login
FIXIAM_POST_LOGOUT_REDIRECT_URI=
FIXIAM_SCOPES=openid profile email
# client_secret_basic or client_secret_post (must match Fixiam client registration)
FIXIAM_TOKEN_AUTH_METHOD=client_secret_basic
# How CAPS links a Fixiam sign-in to the SCIM-provisioned account:
#   subject (default, recommended) = match Fixiam's immutable subject (externalId == sub), then userName, then verified email
#   email   (TEMPORARY demo)       = match primarily on the verified OIDC email claim
# Email-based linking ALWAYS requires the email_verified claim to be true.
# Use "email" only while Fixiam's subject is the user's email; migrate to "subject" once an immutable user ID is available.
CAPS_OIDC_MATCH_STRATEGY=subject
# Provider-specific trusted verified-email issuer (TEMPORARY). When Fixiam omits email_verified,
# CAPS treats the email claim as verified ONLY for a token whose validated issuer (iss) exactly
# equals this value. Relies on Fixiam Engineering's guarantee that its email claims are verified
# addresses. Leave UNSET to require email_verified=true. An explicit email_verified=false is always
# rejected. Scoped to this exact issuer, never global.
# REMOVE this once Fixiam emits email_verified, or once CAPS matches on Fixiam's immutable user ID.
# Value = the exact Fixiam issuer URL (same as FIXIAM_ISSUER_URL's discovered issuer).
CAPS_OIDC_ASSUME_EMAIL_VERIFIED_ISSUER=

# --- DEMO-ONLY unverified-email exception (TEMPORARY, default OFF) ----------
# Lets a SMALL, EXPLICITLY NAMED set of SCIM-provisioned demo users complete account linking
# even though Fixiam currently sends email_verified=false. It is consulted ONLY at the email
# match gate; it NEVER changes the email_verified claim and NEVER marks an email verified. Every
# use is audited as 'authentication.demo_email_verification_override'. It applies only when ALL
# of the following hold, otherwise it is inert (fails closed):
#   - the flag below is exactly "true";
#   - the address is on the explicit allowlist (full addresses only; wildcards/bare domains dropped);
#   - the validated token issuer EXACTLY equals the issuer below;
#   - a single live, ACTIVE, SCIM-provisioned CAPS account matches that email.
# SECURITY: this is operator-intent gated; leaving these three UNSET keeps it fully disabled.
# REMOVE cleanly by deleting these three variables once the demo is complete.
CAPS_DEMO_ALLOW_UNVERIFIED_EMAIL=
CAPS_DEMO_UNVERIFIED_EMAIL_ALLOWLIST=
CAPS_DEMO_UNVERIFIED_EMAIL_ISSUER=

# --- SCIM 2.0 (Fixiam → CAPS provisioning) ---------------------------------
# Bearer token Fixiam presents to /scim/v2. >= 32 chars. Generate: openssl rand -hex 32
SCIM_TOKEN=
